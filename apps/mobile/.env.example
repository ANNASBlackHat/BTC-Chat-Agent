# Base URL of the btc-chat-agent web app (the API backend for this client).
# - iOS/Android simulator: http://localhost:3000 works.
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.20:3000
# - Production: https://your-deployment.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: pre-fills the login screen (convenience only, not a secret store).
# EXPO_PUBLIC_APP_PASSWORD=
